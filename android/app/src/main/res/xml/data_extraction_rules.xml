<?xml version="1.0" encoding="utf-8"?>
<!-- v20.4 · Reglas de extracción (Android 12+): SIN respaldo de plataforma
     ni migración dispositivo-a-dispositivo. El manifiesto ya declara
     allowBackup=false; aquí se declaran reglas VACÍAS de forma explícita
     para que ninguna ruta (cloud, device-transfer) tenga contenido
     respaldable aunque allowBackup cambie por descuido en el futuro.
     El token del relay de la Sala modo Servidor y el resto del estado
     viven SOLO en este teléfono; la copia de seguridad es la de la propia
     app (Ajustes → Respaldo, JSON local con retención 4). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" path="." />
    </device-transfer>
</data-extraction-rules>
