<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de marca ValoraVE: fondo claro del tema (#F7F8F9 = bgLight) + -->
<!-- logo centrado. El bitmap vive en drawable-nodpi/splash_logo.png.     -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#F7F8F9" />
    </item>

    <item
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
