<?xml version="1.0" encoding="utf-8"?>
<!-- Widget 4×1 «Paralelo» (v20): el mercado como héroe en ROJO (acento de
     categoría), BCV de secundario. Día/noche por recursos. IDs intactos. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/widget_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="PARALELO · USD"
        android:textColor="@color/widget_eyebrow"
        android:textSize="11sp"
        android:letterSpacing="0.08"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/widget_rate"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="—"
        android:textColor="@color/widget_accent_parallel"
        android:textSize="34sp"
        android:textStyle="bold"
        android:letterSpacing="-0.02" />

    <LinearLayout
        android:id="@+id/widget_meta"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BCV —"
            android:textColor="@color/widget_secondary"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/widget_updated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text=""
            android:textColor="@color/widget_updated"
            android:textSize="10sp" />
    </LinearLayout>
</LinearLayout>
