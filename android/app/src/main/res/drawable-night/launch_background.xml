<?xml version="1.0" encoding="utf-8"?>
<!-- Splash de marca ValoraVE (modo oscuro): fondo grafito                -->
<!-- (#121417 = bgDark) + logo centrado desde drawable-nodpi.             -->
<!-- La carpeta drawable-night gana sobre drawable-v21 en UI night        -->
<!-- (la precedencia del calificador «night» es mayor que la versión).    -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="#121417" />
    </item>

    <item
        android:gravity="center">
        <bitmap
            android:gravity="center"
            android:src="@drawable/splash_logo" />
    </item>
</layer-list>
