<?xml version="1.0" encoding="utf-8"?>
<!-- Icono adaptive ValoraVE: foreground maskable de marca sobre azul #2749CB.
     Las esquinas del arte se funden con el background (mismo azul) → sin
     bordes visibles en cualquier máscara del launcher. Monochrome: glifo V
     blanco (themed icons Android 13+). -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background"/>
    <foreground android:drawable="@mipmap/ic_launcher_fg"/>
    <monochrome android:drawable="@mipmap/ic_launcher_mono"/>
</adaptive-icon>
